# 复制为 .env 并填入真实值：cp .env.example .env
# ⚠️ .env 已被 .gitignore 忽略，切勿把真实密钥提交到 git

# Kimi (Moonshot) API Key
# 国际版: https://platform.moonshot.ai  控制台 → API Keys
# 中国版: https://platform.moonshot.cn  控制台 → API 密钥
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx

# 中国大陆账号请取消注释下面这行（默认用国际版 api.moonshot.ai）
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# Discord 机器人 Token
# https://discord.com/developers/applications → 你的应用 → Bot → Reset Token
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxx
